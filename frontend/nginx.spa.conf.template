server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 25m;   # screenshots can be large

    # Defer DNS resolution of the upstream to request-time. Without this,
    # nginx resolves the upstream once at boot and crashes if it isn't up yet.
    # ${RESOLVER_ADDRESS} / ${API_UPSTREAM} are substituted at container
    # start by the base image's envsubst-on-templates entrypoint — see
    # frontend/Dockerfile and docs/deployment-and-config.md.
    resolver ${RESOLVER_ADDRESS} valid=10s ipv6=off;

    # ---- Container liveness probe — answered by nginx, never proxied --
    # Dependency-free: must return 200 even if the api container is down.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # ---- Backend routes — proxied to the api container -----------------
    # Order matters: specific patterns before the SPA fallback.
    location /admin/ {
        set $upstream "${API_UPSTREAM}";
        proxy_pass $upstream;
        include /etc/nginx/proxy.conf;
    }
    location /api/ {
        set $upstream "${API_UPSTREAM}";
        proxy_pass $upstream;
        include /etc/nginx/proxy.conf;
    }
    location = /runs {
        set $upstream "${API_UPSTREAM}";
        proxy_pass $upstream;
        include /etc/nginx/proxy.conf;
    }
    location = /tests {
        set $upstream "${API_UPSTREAM}";
        proxy_pass $upstream;
        include /etc/nginx/proxy.conf;
    }
    location ~ ^/tests/[0-9]+$ {
        set $upstream "${API_UPSTREAM}";
        proxy_pass $upstream;
        include /etc/nginx/proxy.conf;
    }
    location ~ ^/baselines/[a-z0-9-]+\.(png|json)$ {
        set $upstream "${API_UPSTREAM}";
        proxy_pass $upstream;
        include /etc/nginx/proxy.conf;
    }
    # `^~` so this prefix wins over the `~* \.(js|css|...)$` regex below —
    # otherwise /static/admin/css/base.css gets served from the local SPA
    # webroot (and 404s) instead of being proxied to Django.
    location ^~ /static/ {
        set $upstream "${API_UPSTREAM}";
        proxy_pass $upstream;
        include /etc/nginx/proxy.conf;
    }

    # ---- Static SPA assets ---------------------------------------------
    location ~* \.(js|css|woff2|svg|png|jpg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- SPA fallback --------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }
}
