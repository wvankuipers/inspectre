# Throwaway values for the production-style smoke stack. Nothing here is a secret;
# the stack is created and destroyed per run. Variable names mirror ../../.env.example.
DJANGO_SECRET_KEY=smoke-test-only-not-a-secret
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

POSTGRES_PASSWORD=smokepass
DATABASE_URL=postgres://inspectre:smokepass@db:5432/inspectre

S3_BUCKET_NAME=inspectre-screenshots
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY_ID=smokeaccess
S3_SECRET_ACCESS_KEY=smokesecretkey
S3_PUBLIC_BASE_URL=http://localhost:18333/inspectre-screenshots

ADMIN_USERNAME=admin
ADMIN_PASSWORD=smoke-admin-pass

# TLS + ACL user, like production's rediss:// broker (minus AWS IAM).
REDIS_URL=rediss://smoke:smokepass@valkey:6379/0?ssl_cert_reqs=none
CELERY_WORKER_CONCURRENCY=2
