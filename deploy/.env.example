# ============================================================================
# Inspectre — local development environment.
# Copy to `.env` (gitignored) and edit the values that say CHANGE_ME.
# ============================================================================

# ---- Django -----------------------------------------------------------------

# Generate a fresh one with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=dev-only-not-for-production-CHANGE_ME

# Local dev: 1 (verbose tracebacks). Production: 0 or unset.
DEBUG=1

# Comma-separated. localhost covers most local cases; add your dev hostname if any.
ALLOWED_HOSTS=localhost,127.0.0.1

# Empty in same-origin topology (dev default). Set in split-host only.
CORS_ALLOWED_ORIGINS=

# ---- Database ---------------------------------------------------------------

POSTGRES_PASSWORD=inspectre
DATABASE_URL=postgres://inspectre:inspectre@db:5432/inspectre

# ---- Object storage (MinIO in dev, S3 in prod) ------------------------------

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniominio
S3_BUCKET_NAME=inspectre-screenshots
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=miniominio
# Browser-reachable base URL for stored files. In dev this is the host-published
# MinIO port; in prod it's the CDN URL fronting the bucket (https://cdn.example.com).
S3_PUBLIC_BASE_URL=http://localhost:9000/inspectre-screenshots

# ---- Inspectre knobs ----------------------------------------------------------
# All optional; defaults match legacy parity.

# IMAGE_DIFF_THRESHOLD=0.1
# RUN_RETENTION_PER_SUITE=5
# DEFAULT_FUZZ_LEVEL=30%
# DEFAULT_HIGHLIGHT_COLOUR=ff0000
# THUMBNAIL_WIDTH=300
# THUMBNAIL_JPEG_QUALITY=90
# IMAGEMAGICK_TIMEOUT_SECONDS=60

# ---- Admin (django-admin only; not the public API) -------------------------

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ---- Gunicorn (production-only) --------------------------------------------

# GUNICORN_WORKERS=3

# ---- AWS IAM authentication (staging/prod on EKS only) --------------------
# Leave unset/0 for local dev — static credentials above are used instead.

# AWS_IAM_AUTH_ENABLED=1
# AWS_REGION=us-east-1

# Required when AWS_IAM_AUTH_ENABLED=1 instead of DATABASE_URL:
# DATABASE_NAME=inspectre
# DATABASE_USER=iam_app_user
# DATABASE_HOST=my-instance.xxxxx.us-east-1.rds.amazonaws.com
# DATABASE_PORT=5432

# Required when AWS_IAM_AUTH_ENABLED=1 instead of REDIS_URL:
# REDIS_HOST=master.my-cluster.xxxxx.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_IAM_USERNAME=iam-cache-user
# The cache name (replication group id) the auth token is signed against — not
# the connection endpoint in REDIS_HOST. See docs/aws-iam-auth.md.
# REDIS_IAM_CACHE_NAME=my-cluster
